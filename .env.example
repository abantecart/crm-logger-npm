# ── Required ─────────────────────────────────────────────────────────────────
# host:port of the audit-log gRPC server (forwarder + direct AuditLogger calls).
AUDIT_GRPC_TARGET=audit-log:50051

# ── gRPC client tuning (optional) ────────────────────────────────────────────
# Per-call deadline. Audit must not block the request path — keep it low.
AUDIT_GRPC_TIMEOUT_MS=2000
# Retries on transient gRPC failures.
AUDIT_GRPC_MAX_RETRIES=1

# ── Service-account auth (optional, client_credentials) ──────────────────────
# Omit all of these to send audit calls without a Bearer token.
AUDIT_GRPC_CLIENT_ID=
AUDIT_GRPC_CLIENT_SECRET=
# Issuer; token endpoint is derived as ${issuer}/protocol/openid-connect/token.
KEYCLOAK_ISSUER_URL=
# Explicit token endpoint (overrides the issuer-derived one).
AUDIT_GRPC_TOKEN_ENDPOINT=
# OAuth scope / audience for the minted token.
AUDIT_GRPC_SCOPE=
AUDIT_GRPC_AUDIENCE=
# Dev-only: accept a self-signed Keycloak TLS cert. Never set true in prod.
KEYCLOAK_ALLOW_SELF_SIGNED_TLS=false

# ── Outbox forwarder (optional) ──────────────────────────────────────────────
# Rows claimed per drain (FOR UPDATE SKIP LOCKED).
OUTBOX_BATCH=50
# Fallback poll interval (ms); primary wake-up is LISTEN/NOTIFY.
OUTBOX_POLL_MS=2000
# Verbose row-level logging for debugging.
AUDIT_DEBUG_LOGS=false

# ── Actor context (optional) ─────────────────────────────────────────────────
# Tenant used when a request carries none.
DEFAULT_TENANT_ID=default
