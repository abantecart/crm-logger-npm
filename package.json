{
  "name": "@abantecart/crm-logger",
  "version": "1.1.0",
  "private": false,
  "main": "dist/contracts/index.js",
  "types": "dist/contracts/index.d.ts",
  "scripts": {
    "codegen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=esModuleInterop=true,env=node,outputServices=grpc-js,outputClientImpl=grpc-js,useOptionals=none,snakeToCamel=true,forceLong=string ./proto/audit/v1/audit.proto",
    "build": "npm run codegen && tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@grpc/grpc-js": "^1.14.1",
    "ulid": "^2.4.0"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "ts-proto": "^2.7.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    ".": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./ui-client": {
      "types": "./dist/ui-client/index.d.ts",
      "default": "./dist/ui-client/index.js"
    },
    "./mappers/grpc": {
      "types": "./dist/mappers/grpc.d.ts",
      "default": "./dist/mappers/grpc.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "default": "./dist/outbox/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "default": "./dist/sql/index.js"
    },
    "./dist/generated/proto/audit/v1/audit": {
      "types": "./dist/generated/proto/audit/v1/audit.d.ts",
      "default": "./dist/generated/proto/audit/v1/audit.js"
    },
    "./generated/*": "./dist/generated/*",
    "./mappers/*": "./dist/mappers/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "proto"
  ]
}
